# 외부 소스/자료 (untrusted — 참조 전용, 커밋 금지)
nginx-src/
poc-external/

# 실험 산출물 (episode JSON은 커밋하되 대용량 원시 로그/코어덤프 제외)
**/results/**/*.log
**/results/**/*.core
**/results/**/core*
**/results/pcap/
*.pcap
*.core
core.*

# 랩 인증서/키 — 절대 커밋 금지
ops/docker/**/*.key
ops/docker/**/*.crt
kube/
*.conf.priv

# 실험 ID/시크릿
.env

# 파이썬
__pycache__/
*.pyc
.venv/

# 에디터/OS
.DS_Store
*.swp
